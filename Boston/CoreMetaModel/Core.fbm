    <ModelNotes>
      <ModelNote Id="18f8f2ef-73b4-4331-adf8-69003d70c988" IsMDAModelElement="true">
        <Note>Envelope</Note>
      </ModelNote>
      <ModelNote Id="982326bc-c50f-412a-b8e2-dd64f99564f3" JoinedObjectTypeId="CoreActorToProcessParticipationRelation" IsMDAModelElement="true">
        <Note>Actor can be None. E.g. For DataSore to Activity. Data can be None.</Note>
      </ModelNote>
      <ModelNote Id="acb0d5a0-08a2-4516-9eac-486cc837efa4" IsMDAModelElement="true">
        <Note>A Choreograph is where a Process (as Choreograph) is associated with one or more Actors in Sequence, and where the first Actor initiates the Choreography. Multiple instances of the same actor can participate.</Note>
      </ModelNote>
    </ModelNotes>
