// 

<% @TinyPG Namespace="VAQL" Language="vb"%>
<% @TextHighlighter Generate="true" %>

ADDITIONALVALUE -> COMMA MODELELEMENT COLON (VALUESTRING | VALUE);
BROPEN 	-> @"\(+";
BRCLOSE 	-> @"\)+";
COLON		-> ":";
COLUMNNAMESTR -> @"[aA-zZ0-9]+";
COMMA         -> ",";
[Color(153, 0, 0)] 
CURLYBRACKETCLOSE -> @"\}+";
[Color(153, 0, 0)] CURLYBRACKETOPEN -> @"\{+";
[Color(153, 0, 0)] DESCRIPTIONCONTENT -> @"([^""]|"""")*";//Requires escaped "" double quotes.
[Color(153, 0, 0)] DOUBLEQUOTE   -> @"""";
EOF           -> @"^$";
EQUALS        -> "=";
FACTTYPENAME -> @"[aA-zZ]+";
[Color(0, 191, 255)] FOLLOWINGREADINGTEXT -> @"[a-z|\s]+$";
[Color(0, 191, 255)] FRONTREADINGTEXT -> @"(?>[a-z]+)[^\-]";
[Color(153, 0, 0)]	ID		-> @"[aA-zZ0-9]+";
MULTDIV 	-> @"\*|/";
MODELNAME     -> @"[aA-zZ]+";
//20221110-[Color(76, 153, 0)]	MODELELEMENTNAME -> @"(([A-Z0-9]+[_a-z\-0-9]+[ |_]*)+[_|\s]?)+"; // @"(([A-Z0-9]+[_a-zA-Z0-9]*[ |_]*)+[_|\s]?)+"; // @"(([A-Z0-9][a-z0-9]+)+[_|\s]?)+"; //(([A-Z][a-z]+)+[_|\s]?)+
[Color(76, 153, 0)]	MODELELEMENTNAME -> @"(((?!(APPEARS|IF\sAND|IF\sSOME|IS|WRITTEN|TO|INCLUDES|HAS LONG DESCRIPTION|SOME|THEN\sTHAT|THAT))[_A-Z0-9<>]+[_a-z\-0-9]*[ |_|>]*)+[_|\s]?)+"; //eclude word \b(?!\W+is\b))+";
NUMBER 	-> @"[0-9]+";
//PAGENAME      -> @"[aA-zZ0-9\s\-]+"; 
PERIOD		-> @"\.";
PLUSMINUS 	-> @"(\+|-)";
[Color(227, 143, 247)]     PAGENAME      -> @"([aA-zZ0-9\-]+[_|\s]?)+"; 
[Color(153, 76, 0)] POSTBOUNDREADINGTEXT -> @"\-[a-z]+";
[Color(153, 76, 0)] PREBOUNDREADINGTEXT -> @"[a-z\s\-]+\-";
[Color(153, 0, 153)]	PREDICATEPART	-> @"(?!([a-z]+\-))(?!([a-z]+$))([a-z]+[^\-])"; //20220804-VM-Was @"(?!([a-z]+\-))(?!([a-z\s]+$))([a-z]+[^\-])";  //([a-z|\s])+(?<!$)"; //(?>[a-z]+)([^\-])(?<!$)
//[Color(153, 0, 153)]	PREDICATEPART	-> @"(?>[a-z]+)[^\-]";
//(?!\s) [^\-$]
PREDICATESPACE -> @"[\s]+";
[Color(76, 153, 0)]	REFERENCEMODE -> @"[A-Z]([aA-zZ][\s]?)+";
[Color(153, 76, 0)] ROLENAME      ->  @"[a-z]+\-?";
[Color(153, 0, 0)]	SINGLEQUOTE   -> @"'";
SQUAREBRACKETOPEN -> @"\[";
SQUAREBRACKETCLOSE -> @"\]";
STAR          -> "\*";
[Color(0, 0, 255)]	SPACE		-> "\s";
[Color(153, 0, 153)]	UNARYPREDICATEPART	-> @"((?>[a-z])+[\s]?)+$"; //@"(?>[a-z]+)";
USERTABLENAME -> @"[aA-zZ0-9]+";
[Color(216, 127, 178)]	VALUECONSTRAINTVALUE -> @"^(?!\s)[aA-zZ0-9%\*\+\?\!&\.\(\) \-\:/]+";
[Color(153, 0, 0)] VARIABLE -> @"[aA-zZ]";
WHERECLAUSECOLUMNNAMESTR -> @"[aA-zZ0-9]+";
[Color(153, 0, 0)]	VALUE         -> @"^[^-\s\'][aA-zZ0-9\-\s+_\#\,\.\:\*\?]*";
VALUELIST     -> BROPEN MODELELEMENT COLON (VALUESTRING | VALUE) (ADDITIONALVALUE)* BRCLOSE;
VALUESTRING	-> SINGLEQUOTE VALUE? SINGLEQUOTE;

//Keywords
[Color(115, 217, 243)]	KEYWDADDOBJECTTYPE -> "ADD OBJECT TYPE";
[Color(135, 207, 243)]	KEYWDADDOBJECTTYPESRELATEDTO -> "ADD OBJECT TYPES RELATED TO"; 
[Color(0, 0, 255)]	KEYWDANYNUMBEROF -> "ANY NUMBER OF";
[Color(0, 0, 255)]	KEYWDANYFACTTYPE -> "ANY FACT TYPE";
[Color(0, 0, 255)]	KEYWDAPPEARSATMOSTONETIMEIN -> "APPEARS AT MOST ONE TIME IN";
[Color(0, 0, 255)]	KEYWDAPPEARSATLEASTONETIMEIN -> "APPEARS AT LEAST ONE TIME IN";
[Color(0, 0, 255)]	KEYWDAPPEARSONCEINANYOF -> "APPEARS ONCE IN ANY OF";
[Color(0, 0, 255)]	KEYWDATLEASTONE -> "AT LEAST ONE";
[Color(0, 0, 255)]	KEYWDATMOSTONE -> "AT MOST ONE";
[Color(105, 170, 203)]	KEYWDCREATE	-> "CREATE";
[Color(0, 0, 255)]	KEYWDHASLONGDESCRIPTION -> "HAS LONG DESCRIPTION";
[Color(0, 0, 255)]	KEYWDIFANDONLYIF -> "IF AND ONLY IF";
[Color(0, 0, 255)]	KEYWDIFSOME -> "IF SOME";
[Color(0, 0, 255)]	KEYWDINCLUDES -> "INCLUDES";
[Color(135, 207, 243)]	KEYWDISA -> "IS A";
[Color(135, 207, 243)]	KEYWDISWHERE -> "IS WHERE";
[Color(96, 96, 96)]	KEYWDDATATYPELOGICALTRUEFALSE 	-> "LogicalTrueFalse";
[Color(96, 96, 96)]	KEYWDDATATYPELOGICALYESNO 		-> "LogicalYesNo";
[Color(96, 96, 96)]	KEYWDDATATYPEAUTOCOUNTER	 	-> "AutoCounter";
[Color(96, 96, 96)]	KEYWDDATATYPEDECIMAL	 		-> "Decimal";
[Color(96, 96, 96)]	KEYWDDATATYPEFLOATCUSTOMPRECISION -> "FloatCustomPrecision";
[Color(96, 96, 96)]	KEYWDDATATYPEFLOATDOUBLEPRECISION -> "FloatDoublePrecision";
[Color(96, 96, 96)]	KEYWDDATATYPEFLOATSINGLEPRECISION -> "FloatSinglePrecision";
[Color(96, 96, 96)]	KEYWDDATATYPEMONEY 			-> "Money";
[Color(96, 96, 96)]	KEYWDDATATYPESIGNEDBIGINTEGER 	-> "SignedBigInteger";
[Color(96, 96, 96)]	KEYWDDATATYPESIGNEDINTEGER 		-> "SignedInteger";
[Color(96, 96, 96)]	KEYWDDATATYPESIGNEDSMALLINTEGER 	-> "SignedSmallInteger";
[Color(96, 96, 96)]	KEYWDDATATYPEUNSIGNEDBIGINTEGER 	-> "UnsignedBigInteger";
[Color(96, 96, 96)]	KEYWDDATATYPEUNSIGNEDINTEGER 	-> "UnsignedInteger";
[Color(96, 96, 96)]	KEYWDDATATYPEUNSIGNEDSMALLINTEGER -> "UnsignedSmallInteger";
[Color(96, 96, 96)]	KEYWDDATATYPEUNSIGNEDTINYINTEGER 	-> "UnsignedTinyInteger";
[Color(96, 96, 96)]	KEYWDDATATYPEOBJECTID 		-> "ObjectID";
[Color(96, 96, 96)]	KEYWDDATATYPEROWID 			-> "RowID";
[Color(96, 96, 96)]	KEYWDDATATYPERAWDATAFIXEDLENGTH 	-> "RawDataFixedLength";
[Color(96, 96, 96)]	KEYWDDATATYPERAWDATALARGELENGTH 	-> "RawDataLargeLength";
[Color(96, 96, 96)]	KEYWDDATATYPERAWDATAOLEOBJECT	-> "RawDataOLEObject";
[Color(96, 96, 96)]	KEYWDDATATYPERAWDATA			-> "RawDataPicture";
[Color(96, 96, 96)]	KEYWDDATATYPERAWDATAVARIABLELENGTH -> "VariableLength";
[Color(96, 96, 96)]	KEYWDDATATYPEAUTOTIMESTAMP 		-> "AutoTimestamp";
[Color(96, 96, 96)]	KEYWDDATATYPEDATE 			-> "Date";
[Color(96, 96, 96)]	KEYWDDATATYPETEMPORALDATE		-> "TemporalDate";
[Color(96, 96, 96)]	KEYWDDATATYPEDATETIME 		-> "TemporalDateTime";
[Color(96, 96, 96)]	KEYWDDATATYPETIME	 		-> "TemporalTime";
[Color(96, 96, 96)]	KEYWDDATATYPESTRINGFIXEDLENGTH 	-> "StringFixedLength";
[Color(96, 96, 96)]	KEYWDDATATYPESTRINGLARGELENGTH 	-> "StringLargeLength";
[Color(96, 96, 96)]	KEYWDDATATYPESTRINGVARIABLELENGTH 	-> "StringVariableLength";
[Color(96, 96, 96)]	KEYWDDATATYPETEXTFIXEDLENGTH 	-> "TextFixedLength";
[Color(96, 96, 96)]	KEYWDDATATYPETEXTLARGELENGTH 	-> "TextLargeLength";
[Color(96, 96, 96)]	KEYWDDATATYPETEXTVARIABLELENGTH 	-> "TextVariableLength";
[Color(0, 0, 255)]	KEYWDIDENTIFIEDBY -> "IDENTIFIED BY";
[Color(0, 0, 255)]	KEYWDISACONCEPT -> "IS A CONCEPT";
[Color(0, 0, 255)]	KEYWDISAKINDOF -> "IS A KIND OF";
[Color(0, 0, 255)]	KEYWDISANENTITYTYPE -> "IS AN ENTITY TYPE";
[Color(0, 0, 255)]	KEYWDISAVALUETYPE -> "IS A VALUE TYPE";
[Color(0, 0, 255)]	KEYWDISIDENTIFIEDBY -> "IS IDENTIFIED BY";
[Color(0, 0, 255)]	KEYWDISOBJECTIFIED -> "IS OBJECTIFIED";
[Color(0, 0, 255)]	KEYWDISWRITTENAS -> "IS WRITTEN AS";
[Color(0, 0, 255)]	KEYWDITS -> "ITS";
[Color(0, 0, 102)]	KEYWDNL 	-> "NL:";
[Color(0, 0, 255)]	KEYWDONE 	-> "ONE";
[Color(135, 207, 243)]	KEYWDPAGE	-> "PAGE";
[Color(0, 0, 255)]	KEYWDREADING 	-> "READING";
[Color(135, 207, 243)]	KEYWDTOPAGE -> "TO PAGE";
[Color(115, 217, 243)]	KEYWDSTANDALONE -> "STAND ALONE";
[Color(0, 0, 255)]	KEYWDSOME -> "SOME";
[Color(105, 170, 203)]	KEYWDTABLEINSTANCE -> "TABLE INSTANCE";
[Color(0, 0, 255)]	KEYWDTHAT -> "THAT";
[Color(0, 0, 255)]	KEYWDTHEIR -> "THEIR";
[Color(0, 0, 255)]	KEYWDTHENTHAT -> "THEN THAT";
[Color(0, 0, 255)]	KEYWDWRITTENAS -> "WRITTEN AS";

//Prompts
NATURALLANGUAGEPROMPT	-> KEYWDNL;

JSON -> (JSONCONTAINER | JSONPRIMITIVE);
KEYWDJSONTRUE -> "true";
KEYWDJSONFALSE -> "false";
JSONBOOLEAN -> (KEYWDJSONTRUE | KEYWDJSONFALSE);
JSONPRIMITIVE -> (NUMBER| DOUBLEQUOTE VALUE DOUBLEQUOTE| DOUBLEQUOTE JSONBOOLEAN DOUBLEQUOTE);
// Where:
// <number> is a valid real number expressed in one of a number of given formats
// <string> is a string of valid characters enclosed in quotes
// <boolean> is one of the literal strings 'true', 'false', or 'null' (unquoted)

JSONCONTAINER -> (JSONOBJECT | JSONARRAY);
JSONARRAY -> SQUAREBRACKETOPEN (JSON (COMMA JSON)*)? SQUAREBRACKETCLOSE; // A sequence of JSON values separated by commas
JSONOBJECT -> CURLYBRACKETOPEN ( JSONMEMBER (COMMA JSONMEMBER)* )? CURLYBRACKETCLOSE; //A sequence of 'members'
JSONMEMBER -> DOUBLEQUOTE MODELELEMENTNAME DOUBLEQUOTE COLON JSON; //A pair consisting of a name, and a JSON value

//Clauses
ADDITIONALVALUECONSTRAINTVALUE -> COMMA (VALUESTRING | VALUE);
BINARYFACTTYPEANYNUMBEROFCLAUSE -> KEYWDANYNUMBEROF MODELELEMENT;
BINARYFACTTYPEATLEASTONECLAUSE -> KEYWDATLEASTONE MODELELEMENT;
BINARYFACTTYPEATMOSTONECLAUSE -> KEYWDATMOSTONE MODELELEMENT;
BINARYFACTTYPEMANYTOONEDEFINITIONCLAUSE -> KEYWDONE MODELELEMENT;
BINARYPREDICATECLAUSE -> (PREDICATECLAUSE MODELELEMENTTYPE)+;
INTERNALUNIQUENESSDETERMINER -> (KEYWDANYNUMBEROF
					     | KEYWDATLEASTONE
                                       | KEYWDATMOSTONE
                                       | KEYWDONE);
DATATYPE		-> (KEYWDDATATYPELOGICALTRUEFALSE | KEYWDDATATYPELOGICALYESNO | KEYWDDATATYPEAUTOCOUNTER	 | KEYWDDATATYPEFLOATDOUBLEPRECISION | KEYWDDATATYPEFLOATSINGLEPRECISION |
                         KEYWDDATATYPESIGNEDBIGINTEGER | KEYWDDATATYPESIGNEDINTEGER | KEYWDDATATYPESIGNEDSMALLINTEGER | KEYWDDATATYPEUNSIGNEDBIGINTEGER | KEYWDDATATYPEUNSIGNEDINTEGER |
                         KEYWDDATATYPEUNSIGNEDSMALLINTEGER | KEYWDDATATYPEUNSIGNEDTINYINTEGER | KEYWDDATATYPEOBJECTID | KEYWDDATATYPEROWID | KEYWDDATATYPERAWDATAOLEOBJECT |
                         KEYWDDATATYPERAWDATA | KEYWDDATATYPEAUTOTIMESTAMP | KEYWDDATATYPEDATE | KEYWDDATATYPEDATETIME | KEYWDDATATYPETEMPORALDATE | KEYWDDATATYPETIME);
DATATYPELENGTH	-> (KEYWDDATATYPERAWDATAFIXEDLENGTH | KEYWDDATATYPERAWDATALARGELENGTH | KEYWDDATATYPERAWDATAVARIABLELENGTH |
                          KEYWDDATATYPESTRINGFIXEDLENGTH | KEYWDDATATYPETEXTFIXEDLENGTH | KEYWDDATATYPESTRINGLARGELENGTH | KEYWDDATATYPETEXTLARGELENGTH | KEYWDDATATYPESTRINGVARIABLELENGTH | KEYWDDATATYPETEXTVARIABLELENGTH) BROPEN NUMBER BRCLOSE;
DATATYPEPRECISION	-> (KEYWDDATATYPEFLOATCUSTOMPRECISION | KEYWDDATATYPEDECIMAL) BROPEN NUMBER BRCLOSE;
DATATYPEPRECISIONANDSCALE    -> KEYWDDATATYPEMONEY BROPEN NUMBER COMMA NUMBER BRCLOSE;
ENTITYTYPEISIDENTIFIEDBYITSCLAUSE -> KEYWDISIDENTIFIEDBY (KEYWDITS | KEYWDTHEIR) REFERENCEMODE VALUETYPEWRITTENASCLAUSE?;
ENTITYTYPEIDENTIFIEDBYITSCLAUSE -> KEYWDIDENTIFIEDBY (KEYWDITS | KEYWDTHEIR) REFERENCEMODE;
FACTCLAUSE	-> (COMMA (VALUELIST | VALUESTRING | VALUE) (PERIOD | COMMA PREDICATECLAUSE MODELELEMENT))+;
FACTTYPECLAUSE	-> PREDICATECLAUSE (BINARYFACTTYPEANYNUMBEROFCLAUSE
					     | BINARYFACTTYPEATLEASTONECLAUSE
                                       | BINARYFACTTYPEATMOSTONECLAUSE
                                       | BINARYFACTTYPEMANYTOONEDEFINITIONCLAUSE
                                       | MODELELEMENT (PREDICATECLAUSE MODELELEMENT)*);
FACTTYPEREADING	-> FRONTREADINGTEXT? MODELELEMENT ((PREDICATECLAUSE MODELELEMENT?)?)* FOLLOWINGREADINGTEXT?;
FACTTYPEREADINGSET	-> FACTTYPEREADING ((COMMA FACTTYPEREADING)?)*;
FACTTYPEREADINGSEQUENCE -> FACTTYPEREADING (THATPREDICATEREADING)*;
FRONTREADINGTEXTCLAUSE -> (FRONTREADINGTEXT PREDICATESPACE?)*;
GRAPHNODE -> BROPEN VARIABLE COLON MODELELEMENTNAME JSON BRCLOSE;
IDENTIFIERMODELELEMENT -> MODELELEMENT COMMA (VALUELIST | VALUE | VALUESTRING);
ISACONCEPTCLAUSE -> KEYWDISACONCEPT;
ISANENTITYTYPECLAUSE -> KEYWDISANENTITYTYPE;
ISAVALUETYPECLAUSE -> KEYWDISAVALUETYPE VALUETYPEWRITTENASCLAUSE?;
ISOBJECTIFIEDCLAUSE -> KEYWDISOBJECTIFIED;
ISWHERECLAUSE -> KEYWDISWHERE FACTTYPESTMT (COMMA FACTTYPESTMT)*;
MODELELEMENT    -> PREBOUNDREADINGTEXT? QUOTEDMODELELEMENTNAME POSTBOUNDREADINGTEXT?;
MODELELEMENTTYPE -> ( BINARYFACTTYPEANYNUMBEROFCLAUSE
                    | BINARYFACTTYPEATLEASTONECLAUSE
                    | BINARYFACTTYPEMANYTOONEDEFINITIONCLAUSE
                    | BINARYFACTTYPEATMOSTONECLAUSE
                    | MODELELEMENT) (VALUETYPEWRITTENASCLAUSE | ENTITYTYPEIDENTIFIEDBYITSCLAUSE)?;
OBJECTIFIEDFACTTYPEISIDENTIFIEDBYITSCLAUSE -> KEYWDISIDENTIFIEDBY (KEYWDITS | KEYWDTHEIR) MODELELEMENT (COMMA MODELELEMENT)+;
PREDICATECLAUSE -> (PREDICATEPART)+;
QUOTEDMODELELEMENTNAME -> SINGLEQUOTE? MODELELEMENTNAME SINGLEQUOTE?;
THATPREDICATEREADING -> KEYWDTHAT (PREDICATECLAUSE (KEYWDTHAT | KEYWDSOME) MODELELEMENT)*;
UNARYPREDICATECLAUSE -> (UNARYPREDICATEPART)+;
VALUECONSTRAINTCLAUSE -> KEYWDINCLUDES (VALUECONSTRAINTVALUE | CURLYBRACKETOPEN VALUECONSTRAINTVALUELIST CURLYBRACKETCLOSE);
VALUECONSTRAINTVALUELIST -> (VALUESTRING | VALUE) ADDITIONALVALUECONSTRAINTVALUE*;
VALUETYPEISWRITTENASCLAUSE -> KEYWDISWRITTENAS (DATATYPE | DATATYPELENGTH | DATATYPEPRECISION | DATATYPEPRECISIONANDSCALE);
VALUETYPEWRITTENASCLAUSE -> KEYWDWRITTENAS (DATATYPE | DATATYPELENGTH | DATATYPEPRECISION | DATATYPEPRECISIONANDSCALE);

//Statements
ADDOBJECTTYPESRELATEDTOMODELELEMENTTOPAGESTMT -> KEYWDADDOBJECTTYPESRELATEDTO QUOTEDMODELELEMENTNAME KEYWDTOPAGE PAGENAME (COMMA KEYWDANYFACTTYPE)?;
ADDOBJECTTYPETOPAGESTMT -> KEYWDADDOBJECTTYPE QUOTEDMODELELEMENTNAME KEYWDTOPAGE PAGENAME (COMMA KEYWDSTANDALONE)?;
BINARYFACTTYPEREADING -> FRONTREADINGTEXT? MODELELEMENT PREDICATECLAUSE INTERNALUNIQUENESSDETERMINER? MODELELEMENT FOLLOWINGREADINGTEXT?;
CREATENODESTMT -> KEYWDCREATE GRAPHNODE;
CREATEPAGESTMT -> KEYWDCREATE KEYWDPAGE PAGENAME;
CREATESTMT	-> KEYWDCREATE (CREATEPAGESTMT);
CREATETABLEINSTANCESTMT -> KEYWDCREATE KEYWDTABLEINSTANCE JSON;
DUALBINARYFACTTYPEREADINGSTMT -> BINARYFACTTYPEREADING COMMA BINARYFACTTYPEREADING;
EQUALITYCONSTRAINT -> FACTTYPEREADING KEYWDIFANDONLYIF FACTTYPEREADING;
EXCLUSIONCONSTRAINT -> MODELELEMENT KEYWDAPPEARSATMOSTONETIMEIN FACTTYPEREADINGSET;
EXCLUSIVEORCONSTRAINT -> MODELELEMENT KEYWDAPPEARSATLEASTONETIMEIN FACTTYPEREADINGSET;
INCLUSIVEORCONSTRAINT -> MODELELEMENT KEYWDAPPEARSONCEINANYOF FACTTYPEREADINGSET;
FACTSTMT	-> IDENTIFIERMODELELEMENT (COMMA PREDICATECLAUSE IDENTIFIERMODELELEMENT)+ PERIOD;
FACTTYPEIDENTIFICATION	-> MODELELEMENT PREDICATECLAUSE; //20220804-VM-Was (PREDICATECLAUSE | KEYWDISA);
FACTTYPESTMT		-> FACTTYPEIDENTIFICATION MODELELEMENT (PREDICATECLAUSE MODELELEMENT)*;
FACTREADINGSTMT	   -> KEYWDREADING FRONTREADINGTEXT? MODELELEMENT ((PREDICATECLAUSE MODELELEMENT)?)* FOLLOWINGREADINGTEXT?;
LONGDESCRIPTIONSTMT	-> MODELELEMENTNAME KEYWDHASLONGDESCRIPTION DOUBLEQUOTE DESCRIPTIONCONTENT DOUBLEQUOTE;
MODELELEMENTLEADINGSTMT	-> FRONTREADINGTEXTCLAUSE? (MODELELEMENT | QUOTEDMODELELEMENTNAME) (
                                                 KEYWDISAKINDOF QUOTEDMODELELEMENTNAME |
                                                 ISACONCEPTCLAUSE |
                                                 ISANENTITYTYPECLAUSE |
                                                 ISAVALUETYPECLAUSE |
							 ISOBJECTIFIEDCLAUSE |
                                                 ISWHERECLAUSE |
                                                 OBJECTIFIEDFACTTYPEISIDENTIFIEDBYITSCLAUSE |
                                                 ENTITYTYPEISIDENTIFIEDBYITSCLAUSE |
                                                 VALUETYPEISWRITTENASCLAUSE |
						 	 FACTCLAUSE |
							 VALUECONSTRAINTCLAUSE |
                                                 BINARYPREDICATECLAUSE |
                                                 UNARYPREDICATECLAUSE
                                                  ) FOLLOWINGREADINGTEXT?;
SUBSETCONSTRAINTSTMT -> KEYWDIFSOME FACTTYPEREADINGSEQUENCE KEYWDTHENTHAT FACTTYPEREADINGSEQUENCE;
BASEPRODUCTION	-> NATURALLANGUAGEPROMPT? (
//							 EXCLUSIVEORCONSTRAINT
//							| INCLUSIVEORCONSTRAINT
//							| EXCLUSIONCONSTRAINT
//							| EQUALITYCONSTRAINT
//							| SUBSETCONSTRAINTSTMT							
							CREATENODESTMT
							| CREATETABLEINSTANCESTMT
							| FACTSTMT
							| LONGDESCRIPTIONSTMT
							| DUALBINARYFACTTYPEREADINGSTMT
							| CREATEPAGESTMT
							| ADDOBJECTTYPESRELATEDTOMODELELEMENTTOPAGESTMT
							| ADDOBJECTTYPETOPAGESTMT
							| MODELELEMENTLEADINGSTMT
						    )? ;
//BASEPRODUCTION	-> NATURALLANGUAGEPROMPT? (FACTREADINGSTMT | MODELELEMENTLEADINGSTMT)?;

[Skip] WHITESPACE    -> @"\s+";

Start 		 -> 
                  (BASEPRODUCTION
		     )*
EOF;