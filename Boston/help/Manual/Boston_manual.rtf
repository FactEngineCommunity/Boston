\par }{\rtlch\fcs1 \ab\af1\afs20 \ltrch\fcs0 \b\f1\fs20\insrsid2967002 Parameters
\par 
\par }{\rtlch\fcs1 \af1\afs20 \ltrch\fcs0 \f1\fs20\insrsid2967002 arg1 \endash  string. The application to execute.
\par arg2 \endash  string.Command line arguments for the application set in arg1.
\par 
\par }{\rtlch\fcs1 \ab\af1\afs20 \ltrch\fcs0 \b\f1\fs20\insrsid2967002 Returns
\par 
\par }{\rtlch\fcs1 \af1\afs20 \ltrch\fcs0 \f1\fs20\insrsid2967002 Null
\par  
\par E.g.
\par 
\par command("cmd", "/c delete c:\\dev\\file.txt")
\par command("c:\\dev\\postbuild.bat", "")
\par 
\par }\pard\plain \ltrpar\s4\ql \li0\ri0\keepn\widctlpar\tx1200\wrapdefault\faauto\outlinelevel3\rin0\lin0\itap0 \rtlch\fcs1 \ab\af1\afs24\alang1025 \ltrch\fcs0 \b\f1\fs24\ul\lang1252\langfe3081\cgrid\langnp1252\langfenp3081 {\rtlch\fcs1 \af1 \ltrch\fcs0 
